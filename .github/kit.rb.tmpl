# Generated by .github/bump-tap.sh on every tagged release. Edits here are
# overwritten; change the template in hev/kit instead.
class Kit < Formula
  desc "Make your machine part of a software factory"
  homepage "https://hev.dev/kit"
  license "Apache-2.0"

  # The capture daemon runs under launchd; there is no Linux build to fall
  # back to.
  depends_on :macos

  # Not `on_arm`/`on_intel`. Those blocks install and run, but `brew audit`
  # rejects url and sha256 inside them.
  if Hardware::CPU.arm?
    url "https://github.com/hev/kit/releases/download/v@@VERSION@@/kit_@@VERSION@@_darwin_arm64.tar.gz"
    sha256 "@@SHA_ARM64@@"
  else
    url "https://github.com/hev/kit/releases/download/v@@VERSION@@/kit_@@VERSION@@_darwin_amd64.tar.gz"
    sha256 "@@SHA_AMD64@@"
  end

  def install
    bin.install "hev"
  end

  def caveats
    <<~EOS
      `hev up` starts the local archive and dashboard with Docker and installs
      the capture daemon under launchd. Docker must be running; no API key is
      needed. Secret redaction is enabled by default.

      `hev down` stops services and keeps the archive.
      After upgrading, run `hev up` to restart services on the new release.
    EOS
  end

  test do
    assert_match "hev kit", shell_output("#{bin}/hev --help")
  end
end
