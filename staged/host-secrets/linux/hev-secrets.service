# Staged unit for a Linux host that runs no hevd: kit's memory-only secrets
# endpoint on its own. Install as ~/.config/systemd/user/hev-secrets.service.
# Never put a token in this file; the daemon reads the token file at use time.
[Unit]
Description=hev Kit local secrets cache (memory only)

[Service]
Type=simple
ExecStart=%h/.local/bin/hev daemon --secrets-only
Environment=HEV_OP_TOKEN_FILE=%h/.config/op/token
Restart=on-failure
RestartSec=60
UMask=0077

[Install]
WantedBy=default.target
