---
// Terminal startup banner shown in the hero panel: the canonical hev head
// sprite beside the summary of what `hev up` starts.
interface Props {
	narrow?: boolean;
}
const { narrow = false } = Astro.props;

const lead = "hevd is up: capturing traces into files and taking dispatched work on this machine.";
const lines: [string, string][] = [
	["search", 'hev traces search "why did the preflight fail"'],
	["dashboard", "hev serve"],
	["dispatch", "hev dispatch ls"],
	["archive", "~/.hev/traces"],
	["stop", "hev down"],
];
---

<span class:list={["hevd", { narrow }]} role="img" aria-label="The hev head mascot beside the hev up status summary">
	<img class="hev-head" src="/img/hev-head.png" alt="" width="56" height="56" />
	<span class="hevd-lines">
		<span class="lead">{narrow ? "hevd is up: capturing traces and\ntaking dispatched work here." : lead}</span>
		{
			!narrow &&
				lines.map(([label, value]) => (
					<span class="row">
						<span class="lbl">{label.padEnd(11)}</span>
						<span class="val">{value}</span>
					</span>
				))
		}
	</span>
</span>

<style>
	.hevd {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		margin: 0.65em 0 0.75em;
		white-space: normal;
	}

	.hevd.narrow {
		flex-direction: column;
		gap: 0.5rem;
	}

	.hev-head {
		width: 56px;
		height: 56px;
		flex: 0 0 auto;
		image-rendering: pixelated;
		display: block;
	}

	.hevd-lines {
		display: flex;
		flex-direction: column;
		gap: 0.14em;
		line-height: 1.3;
		min-width: 0;
	}

	.row {
		display: block;
		white-space: pre;
	}

	.lbl {
		color: var(--muted);
	}

	.lead {
		font-weight: 700;
		color: var(--ink);
		white-space: pre-wrap;
	}
</style>
