---
// The seafloor, at the bottom of the dive. Full bleed: the archive sits in the
// sunken toolbox and the mascot dances on the sand beside it once the floor
// comes into view (Dive.astro's script sets .on). Only in html.deep.
---

<section class="floor" aria-label="The seafloor">
	<img class="bed" src="/deep/seabed.webp" width="2200" height="933" loading="lazy" alt="" />
	<div class="say">
		<p>
			You've reached the seafloor, and your archive is down here with you, in the sunken
			toolbox. hev kit is part of <a href="https://hevmind.com">hev mind</a>. Search runs on
			<a href="https://hevlayer.com">hev layer</a>.
		</p>
		<p class="credit">
			hevd, the red imp, is ours.
		</p>
	</div>
	<a class="dancer" href="https://hevmind.com" aria-label="hev mind">
		<img src="/img/disco.png" alt="" width="222" height="300" loading="lazy" />
	</a>
	<img
		class="imp"
		src="/img/hevd.png"
		alt="hevd, a small red imp in a diving mask and flippers"
		width="195"
		height="200"
		loading="lazy"
	/>
</section>

<style>
	.floor {
		display: none;
	}

	:global(html.deep) .floor {
		position: relative;
		isolation: isolate;
		min-height: clamp(380px, 42vw, 640px);
		display: flex;
		align-items: flex-start;
	}

	.bed {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% bottom;
		z-index: -1;
		mask: linear-gradient(transparent, #000 38%);
		-webkit-mask: linear-gradient(transparent, #000 38%);
	}

	.say {
		width: var(--page);
		margin: 0 auto;
		padding: 5vw 0 0;
	}

	.say p {
		margin: 0 auto 0.6rem;
		max-width: 40rem;
		font-size: 0.95rem;
		color: var(--ink-soft);
	}

	.say .credit {
		font-size: 0.8rem;
		color: var(--muted);
	}

	.say a {
		color: var(--ink);
		text-decoration-color: var(--signal);
		text-decoration-thickness: 2px;
		font-weight: 500;
	}

	.say a:hover {
		color: var(--signal);
	}

	.dancer {
		position: absolute;
		left: 20%;
		bottom: 9%;
		line-height: 0;
		border-radius: 4px;
	}

	.dancer img {
		height: clamp(96px, 11vw, 150px);
		width: auto;
		transform-origin: 50% 100%;
		display: block;
		image-rendering: pixelated;
	}

	.floor:global(.on) .dancer img {
		animation: bop 0.8s steps(1, end) infinite;
	}

	/* hevd, in a diving mask and flippers, keeps an eye on the toolbox. */
	.imp {
		position: absolute;
		right: 12%;
		bottom: 6%;
		height: clamp(64px, 7vw, 100px);
		width: auto;
		image-rendering: pixelated;
	}

	/* Stepped, so it moves like the pixel art it is. */
	@keyframes bop {
		0% {
			transform: translateY(0) rotate(-6deg);
		}
		25% {
			transform: translateY(-4px) rotate(0);
		}
		50% {
			transform: translateY(0) rotate(6deg) scaleX(-1);
		}
		75% {
			transform: translateY(-4px) rotate(0) scaleX(-1);
		}
	}

	@media (max-width: 720px) {
		.dancer {
			left: 8%;
			bottom: 7%;
		}

		.imp {
			right: 6%;
		}

		.bed {
			object-position: 66% bottom;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.floor:global(.on) .dancer img {
			animation: none;
		}
	}
</style>
