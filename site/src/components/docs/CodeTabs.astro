---
// Tabbed code examples: one tab per fenced code block placed in the slot,
// labeled by the block's language. Tab selection syncs across every
// CodeTabs group on the page and persists across pages via localStorage,
// so a reader who picks Go sees Go everywhere. Styling lives in DocsLayout
// alongside the rest of the doc-body rules.
//
// A block wrapped in <AgentPrompt> becomes an "Agent prompt" tab. Whether
// the reader last chose code or the agent prompt is stored separately from
// the language, and applies to every group that has a prompt tab.
interface Props {
	labels?: string[];
	label?: string;
}
const { labels, label = labels ? "Setup backend" : "Language" } = Astro.props;
---

<figure class="code-tabs" data-code-tabs data-tab-labels={labels ? JSON.stringify(labels) : undefined}>
	<figcaption class="code-tabs-bar">
		<div class="code-tabs-langs" role="tablist" aria-label={label}></div>
		<button type="button" class="code-copy" data-code-tabs-copy aria-label="Copy code">copy</button>
	</figcaption>
	<div class="code-tabs-panels">
		<slot />
	</div>
</figure>

<script>
	const STORAGE_KEY = "hevlayer-docs-lang";
	const VIEW_KEY = "hevkit-docs-view";
	const PROMPT = "agent-prompt";
	const LABELS: Record<string, string> = {
		python: "Python",
		go: "Go",
		typescript: "TypeScript",
		ts: "TypeScript",
		bash: "Shell",
		curl: "cURL",
		sh: "Shell",
		shell: "Shell",
		http: "HTTP",
		json: "JSON",
		jsonc: "JSON",
		yaml: "YAML",
		toml: "TOML",
		text: "Text",
		plaintext: "Text",
		powershell: "PowerShell",
		markdown: "Markdown",
		[PROMPT]: "Agent prompt",
	};

	interface Group {
		root: HTMLElement;
		custom: boolean;
		langs: string[];
		buttons: Map<string, HTMLButtonElement>;
		panels: Map<string, HTMLElement>;
		lastCode?: string;
	}

	const groups: Group[] = [];

	function storedLang(): string | null {
		try {
			return localStorage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	}

	function storeLang(lang: string) {
		try {
			localStorage.setItem(STORAGE_KEY, lang);
		} catch {
			/* private mode: selection still applies for this page */
		}
	}

	function storedView(): string | null {
		try {
			return localStorage.getItem(VIEW_KEY);
		} catch {
			return null;
		}
	}

	function storeView(view: "code" | "prompt") {
		try {
			localStorage.setItem(VIEW_KEY, view);
		} catch {
			/* private mode: selection still applies for this page */
		}
	}

	// The code tab a group shows when the reader is not on the prompt tab.
	function codeLang(group: Group): string {
		const codes = group.langs.filter((lang) => lang !== PROMPT);
		const lang = group.custom ? group.lastCode : storedLang();
		return lang && codes.includes(lang) ? lang : codes[0] ?? group.langs[0];
	}

	function activate(group: Group, lang: string) {
		for (const [key, button] of group.buttons) {
			const active = key === lang;
			button.setAttribute("aria-selected", active ? "true" : "false");
			button.tabIndex = active ? 0 : -1;
			const panel = group.panels.get(key);
			if (panel) panel.hidden = !active;
		}
		group.root.dataset.activeLang = lang;
		if (lang !== PROMPT) group.lastCode = lang;
	}

	function select(selectedGroup: Group, lang: string) {
		if (lang === PROMPT) {
			storeView("prompt");
			for (const group of groups) if (group.langs.includes(PROMPT)) activate(group, PROMPT);
			return;
		}
		const leavingPrompt = selectedGroup.root.dataset.activeLang === PROMPT;
		if (leavingPrompt) storeView("code");
		if (selectedGroup.custom) activate(selectedGroup, lang);
		else storeLang(lang);
		for (const group of groups) {
			if (group === selectedGroup && group.custom) continue;
			if (!group.custom && group.langs.includes(lang)) activate(group, lang);
			else if (leavingPrompt && group.root.dataset.activeLang === PROMPT) activate(group, codeLang(group));
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
		const bar = root.querySelector<HTMLElement>(".code-tabs-langs");
		const panelHost = root.querySelector<HTMLElement>(".code-tabs-panels");
		if (!bar || !panelHost) continue;

		const labels: string[] | undefined = root.dataset.tabLabels ? JSON.parse(root.dataset.tabLabels) : undefined;
		const group: Group = { root, custom: !!labels, langs: [], buttons: new Map(), panels: new Map() };

		let codeIndex = 0;
		for (const pre of panelHost.querySelectorAll<HTMLElement>("pre")) {
			const index = group.langs.length;
			const isPrompt = !!pre.closest("[data-agent-prompt]");
			const lang = isPrompt ? PROMPT : labels ? `option-${codeIndex++}` : pre.dataset.language || "text";
			if (group.panels.has(lang)) continue;
			group.langs.push(lang);
			group.panels.set(lang, pre);

			const button = document.createElement("button");
			button.type = "button";
			button.role = "tab";
			button.textContent = isPrompt ? LABELS[PROMPT] : labels?.[codeIndex - 1] ?? LABELS[lang] ?? lang;
			const id = `code-tabs-${groups.length}-${index}`;
			button.id = `${id}-tab`;
			button.setAttribute("aria-controls", `${id}-panel`);
			pre.id = `${id}-panel`;
			pre.setAttribute("role", "tabpanel");
			pre.setAttribute("aria-labelledby", button.id);
			button.setAttribute("aria-selected", "false");
			button.addEventListener("click", () => select(group, lang));
			button.addEventListener("keydown", event => {
				const current = group.langs.indexOf(lang);
				const next = event.key === "ArrowRight" ? (current + 1) % group.langs.length
					: event.key === "ArrowLeft" ? (current + group.langs.length - 1) % group.langs.length
					: event.key === "Home" ? 0 : event.key === "End" ? group.langs.length - 1 : -1;
				if (next < 0) return;
				event.preventDefault();
				select(group, group.langs[next]);
				group.buttons.get(group.langs[next])?.focus();
			});
			bar.appendChild(button);
			group.buttons.set(lang, button);
		}

		if (group.langs.length === 0) continue;
		groups.push(group);

		activate(group, storedView() === "prompt" && group.langs.includes(PROMPT) ? PROMPT : codeLang(group));

		root
			.querySelector<HTMLButtonElement>("[data-code-tabs-copy]")
			?.addEventListener("click", async (event) => {
				const button = event.currentTarget as HTMLButtonElement;
				const active = group.panels.get(root.dataset.activeLang ?? "");
				if (!active) return;
				try {
					await navigator.clipboard.writeText(active.textContent ?? "");
					button.textContent = "copied";
				} catch {
					button.textContent = "failed";
				}
				setTimeout(() => {
					button.textContent = "copy";
				}, 1400);
			});
	}
</script>
