---
import Base from "./Base.astro";
import { getDocHref, getDocNavGroups, getDocSiblings, type DocEntry } from "../lib/docs";

interface Heading { depth: number; slug: string; text: string; }
interface Props { entry: DocEntry; headings: Heading[]; }

const { entry, headings } = Astro.props;
const href = (id: string) => getDocHref(id);
const navGroups = await getDocNavGroups();
const { previous, next } = await getDocSiblings(entry.id);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<Base title={`hev kit docs - ${entry.data.title}`} description={entry.data.description} current="docs" noindex={entry.data.noindex}>
	<main class="docs-shell">
		<aside class="docs-sidebar" aria-label="Docs navigation">
	<nav class="docs-nav">
				{
					navGroups.map((group) => (
						<section class="nav-group" aria-labelledby={`nav-${group.label}`}>
							<h2 id={`nav-${group.label}`}>{group.label}</h2>
							<ul>
								{group.items.map((item) => (
									<li>
										<a
											href={href(item.id)}
											aria-current={item.id === entry.id ? "page" : undefined}
										>
											{item.data.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</nav>
		</aside>

		<article class="docs-content">
			<header class="doc-header">
				<div class="doc-header-controls">
					<div class="doc-header-meta">
						<p class="eyebrow">{entry.data.group}</p>
					</div>
				</div>
				<h1 id="page-title" tabindex="-1">{entry.data.title}</h1>
			</header>

			<div class="doc-body">
				<slot />
			</div>

			<nav class="doc-pagination" aria-label="Docs pagination">
				{
					previous ? (
						<a href={href(previous.id)} class="pager prev">
							<span>previous</span>
							{previous.data.title}
						</a>
					) : (
						<span></span>
					)
				}
				{
					next && (
						<a href={href(next.id)} class="pager next">
							<span>next</span>
							{next.data.title}
						</a>
					)
				}
			</nav>
		</article>

		<aside class="docs-toc" aria-label="On this page">
			<h2>On this page</h2>
			<nav>
				{
					tocHeadings.map((heading) => (
						<a href={`#${heading.slug}`}>{heading.text}</a>
					))
				}
			</nav>
			<button type="button" data-copy-page>copy page</button>
		</aside>
	</main>

	<script is:inline>
		// Keep the active page visible in the scrollable nav rail
		// (.docs-sidebar on desktop, .docs-nav on mobile).
		for (const rail of document.querySelectorAll(".docs-sidebar, .docs-nav")) {
			if (rail.scrollHeight <= rail.clientHeight) continue;
			const active = rail.querySelector('a[aria-current="page"]');
			if (!active) continue;
			const railRect = rail.getBoundingClientRect();
			const activeRect = active.getBoundingClientRect();
			if (activeRect.bottom > railRect.bottom || activeRect.top < railRect.top) {
				rail.scrollTop += activeRect.top - railRect.top - rail.clientHeight / 2;
			}
			break;
		}

		// Wrap tables so wide ones scroll within their own box instead of
		// widening the page on narrow viewports.
		for (const table of document.querySelectorAll(".doc-body table")) {
			if (table.closest(".table-wrap")) continue;
			const wrapper = document.createElement("div");
			wrapper.className = "table-wrap";
			table.parentNode.insertBefore(wrapper, table);
			wrapper.appendChild(table);
		}

		// Floating copy button on every standalone code block. Tabbed groups
		// (CodeTabs) carry their own copy control; diagrams are excluded by
		// the .astro-code selector.
		for (const pre of document.querySelectorAll(".doc-body pre.astro-code")) {
			if (pre.closest("[data-code-tabs]")) continue;
			const wrapper = document.createElement("div");
			wrapper.className = "code-block";
			pre.parentNode.insertBefore(wrapper, pre);
			wrapper.appendChild(pre);
			const button = document.createElement("button");
			button.type = "button";
			button.className = "code-copy code-copy-floating";
			button.setAttribute("aria-label", "Copy code");
			button.textContent = "copy";
			button.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(pre.textContent ?? "");
					button.textContent = "copied";
				} catch {
					button.textContent = "failed";
				}
				setTimeout(() => {
					button.textContent = "copy";
				}, 1400);
			});
			wrapper.appendChild(button);
		}

		document.querySelector("[data-copy-page]")?.addEventListener("click", async (event) => {
			const button = event.currentTarget;
			try {
				await navigator.clipboard.writeText(window.location.href);
				button.textContent = "copied";
				setTimeout(() => {
					button.textContent = "copy page";
				}, 1400);
			} catch {
				button.textContent = "copy failed";
				setTimeout(() => {
					button.textContent = "copy page";
				}, 1400);
			}
		});

	</script>
</Base>

<style>
	.edition-switch { margin-bottom: .75rem; display: inline-flex; gap: .125rem; padding: .1875rem; border: 1px solid var(--rule); border-radius: 5px; }
	.edition-switch a { padding: .3rem .75rem; border-radius: 3px; font-size: .75rem; line-height: 1.4; color: var(--muted); text-decoration: none; }
	.edition-switch a:hover { color: var(--ink); background: var(--paper-warm); }
	.edition-switch a[aria-current] { background: var(--ink); color: var(--paper); }
	.edition-switch a:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
	.edition-label { margin: 0 0 1.5rem; font-size: .8125rem; font-weight: 500; color: var(--ink); }
	.docs-shell {
		width: min(100% - 2.5rem, 1290px);
		margin: 0 auto;
		padding: 2rem 0 5rem;
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr) 190px;
		gap: 2.5rem;
		align-items: start;
	}

	.docs-sidebar,
	.docs-toc {
		position: sticky;
		top: 5rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--rule-strong) transparent;
	}

	.docs-sidebar,
	.docs-toc {
		background: var(--paper-warm);
		border: 1px solid var(--rule);
		padding: 1.25rem 1rem;
	}

	.docs-sidebar::-webkit-scrollbar,
	.docs-toc::-webkit-scrollbar,
	.docs-nav::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}

	.docs-sidebar::-webkit-scrollbar-track,
	.docs-toc::-webkit-scrollbar-track,
	.docs-nav::-webkit-scrollbar-track {
		background: transparent;
	}

	.docs-sidebar::-webkit-scrollbar-thumb,
	.docs-toc::-webkit-scrollbar-thumb,
	.docs-nav::-webkit-scrollbar-thumb {
		background: var(--rule-strong);
		border-radius: 999px;
	}

	.docs-sidebar::-webkit-scrollbar-thumb:hover,
	.docs-toc::-webkit-scrollbar-thumb:hover,
	.docs-nav::-webkit-scrollbar-thumb:hover {
		background: var(--muted);
	}

	.doc-header-controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.doc-header-controls .eyebrow { margin: 0; }
	.doc-header-meta { display: flex; align-items: center; gap: 0.6rem; }

	@media (max-width: 600px) {
		.doc-header-controls { flex-direction: column; align-items: flex-start; }
	}

	.docs-nav h2,
	.docs-toc h2,
	.eyebrow {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.docs-nav {
		display: flex;
		flex-direction: column;
		gap: 1.65rem;
	}

	.nav-group h2,
	.docs-toc h2 {
		margin-bottom: 0.75rem;
	}

	.nav-group ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.docs-toc a[hidden] { display: none; }

	.nav-group a,
	.docs-toc a {
		display: block;
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.875rem;
		line-height: 1.35;
		padding: 0.15rem 0;
	}

	.nav-group a:hover,
	.nav-group a[aria-current="page"],
	.docs-toc a:hover {
		color: var(--signal);
	}

	/* Docs prose sits on a solid panel — body copy over the page's graph paper
	   is hard to read at length. */
	.docs-content {
		min-width: 0;
		max-width: calc(var(--measure) + 4rem);
		background: var(--paper-warm);
		border: 1px solid var(--rule);
		padding: 0 2rem 2rem;
	}

	@media (max-width: 880px) {
		.docs-content { padding: 0 1.25rem 1.5rem; }
	}

	.doc-header {
		padding: 2rem 0 0;
		margin-bottom: 2rem;
	}

	@media (max-width: 880px) {
		.docs-content {
			padding: 0 1.25rem 1.5rem;
		}
	}

	.eyebrow {
		color: var(--signal);
		margin-bottom: 1rem;
	}

	h1,
	.doc-body :global(h2) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		letter-spacing: 0;
	}

	h1 {
		font-size: 3rem;
		line-height: 1.05;
		margin-bottom: 1rem;
	}

	.doc-header p {
		color: var(--ink-soft);
		font-size: 1.0625rem;
		max-width: 620px;
	}

	.doc-body :global(h2) {
		font-size: 1.15rem;
		margin: 3.25rem 0 1rem;
		scroll-margin-top: 6rem;
	}

	.doc-body :global(h2:first-child) {
		margin-top: 0;
	}

	.doc-body :global(p) {
		color: var(--ink-soft);
		margin-bottom: 1rem;
	}

	.doc-body :global(ul) {
		list-style: disc outside;
		padding: 0;
		padding-left: 1.25rem;
		margin: 1rem 0;
	}

	.doc-body :global(ul li) {
		color: var(--ink-soft);
		line-height: 1.45;
		margin: 0.25rem 0;
		padding-left: 0.25rem;
	}

	.doc-body :global(ul li::marker) {
		color: var(--signal);
	}

	.doc-body :global(ol) {
		list-style: decimal outside;
		padding: 0;
		padding-left: 1.5rem;
		margin: 1rem 0;
	}

	.doc-body :global(ol li) {
		color: var(--ink-soft);
		line-height: 1.45;
		margin: 0.25rem 0;
		padding-left: 0.25rem;
	}

	.doc-body :global(ol li::marker) {
		color: var(--signal);
	}

	.doc-body :global(.steps) {
		counter-reset: step;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0;
		margin: 1rem 0;
	}

	.doc-body :global(.steps li) {
		counter-increment: step;
		position: relative;
		padding: 1rem 1rem 1rem 3.5rem;
		border: 1px solid var(--rule);
		background: var(--paper-warm);
	}

	.doc-body :global(.steps li::before) {
		content: counter(step, decimal-leading-zero);
		position: absolute;
		left: 1rem;
		top: 1rem;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.8125rem;
		color: var(--signal);
	}

	.doc-body :global(.steps strong) {
		display: block;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.9375rem;
		color: var(--ink);
		margin-bottom: 0.25rem;
	}

	.doc-body :global(.steps li span) {
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}

	.doc-body :global(.callout) {
		margin: 1.5rem 0;
		padding: 1.25rem 1.5rem;
		border-left: 3px solid var(--signal);
		background: var(--paper-warm);
	}

	.doc-body :global(.callout > span) {
		display: block;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink);
		margin-bottom: 0.45rem;
	}

	.doc-body :global(.callout > span::before) {
		content: "// ";
		color: var(--signal);
	}

	.doc-body :global(.callout p) {
		margin: 0;
	}

	.doc-body :global(.callout .table-wrap) {
		margin: 0.25rem 0 0.75rem;
	}

	.doc-body :global([data-postgres-limitation] > .callout) {
		border: 2px dashed var(--signal);
	}

	.doc-body :global(.upstream) {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--rule-strong);
		border-left: 3px solid var(--signal);
		background: color-mix(in srgb, var(--signal) 6%, var(--paper-warm));
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.doc-body :global(.upstream:first-child) { margin-top: 0; }

	.doc-body :global(.upstream-label) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.doc-body :global(.upstream-label::before) {
		content: "↗ ";
		color: var(--signal);
	}

	.doc-body :global(.upstream-body p) {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}

	.doc-body :global(.upstream-link) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.8125rem;
		color: var(--signal);
		text-decoration: none;
		align-self: flex-start;
	}

	.doc-body :global(.upstream-link:hover) {
		text-decoration: underline;
	}

	.doc-body :global(pre) {
		position: relative;
		/* !important: Shiki inlines the theme background; keep the site's
		   code surface instead. Token colors still come from the theme. */
		background: var(--code-bg) !important;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		color: var(--code-ink);
		overflow-x: auto;
		padding: 1.4rem 1.2rem;
		margin: 1.25rem 0;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	/* --- code blocks: copy buttons + tab groups --- */

	.doc-body :global(.code-block) {
		position: relative;
		margin: 1.25rem 0;
	}

	.doc-body :global(.code-block pre) {
		margin: 0;
	}

	.doc-body :global(.code-copy) {
		appearance: none;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		background: var(--paper-warm);
		color: var(--muted);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.55rem;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
	}

	.doc-body :global(.code-copy:hover) {
		color: var(--signal);
		border-color: var(--signal);
	}

	.doc-body :global(.code-copy-floating) {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		background: var(--code-bg);
		opacity: 0;
	}

	.doc-body :global(.code-block:hover .code-copy-floating),
	.doc-body :global(.code-block:focus-within .code-copy-floating) {
		opacity: 1;
	}

	@media (hover: none) {
		.doc-body :global(.code-copy-floating) {
			opacity: 1;
		}
	}

	.doc-body :global(.code-tabs) {
		margin: 1.25rem 0;
	}

	.doc-body :global(.code-tabs-bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		border: 1px solid var(--rule-strong);
		border-bottom: none;
		border-radius: 2px 2px 0 0;
		background: var(--paper-warm);
		padding: 0 0.5rem 0 0;
	}

	.doc-body :global(.code-tabs-langs) {
		display: flex;
		overflow-x: auto;
	}

	.doc-body :global(.code-tabs-langs button) {
		appearance: none;
		border: none;
		background: transparent;
		color: var(--muted);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		padding: 0.6rem 0.85rem;
		cursor: pointer;
		box-shadow: inset 0 -2px 0 transparent;
		transition: color 0.15s ease, box-shadow 0.15s ease;
		white-space: nowrap;
	}

	.doc-body :global(.code-tabs-langs button:hover) {
		color: var(--ink);
	}

	.doc-body :global(.code-tabs-langs button[aria-selected="true"]) {
		color: var(--signal);
		box-shadow: inset 0 -2px 0 var(--signal);
	}

	.doc-body :global(.code-tabs-panels pre) {
		margin: 0;
		border-radius: 0 0 2px 2px;
	}

	/* Agent prompts are prose: wrap them instead of scrolling sideways. */
	.doc-body :global(.agent-prompt pre),
	.doc-body :global(.agent-prompt pre code) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	/* Shared backend control in the page header. */

	.doc-header :global(.store-switch) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin: 0;
	}

	.doc-header :global(.store-switch-label) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.doc-header :global(.store-switch-options) {
		display: inline-flex;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		overflow: hidden;
	}

	.doc-header :global(.store-switch-options button) {
		appearance: none;
		border: none;
		border-left: 1px solid var(--rule-strong);
		background: transparent;
		color: var(--muted);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		padding: 0.4rem 0.85rem;
		cursor: pointer;
		transition: color 0.15s ease, background 0.15s ease;
	}

	.doc-header :global(.store-switch-options button:first-of-type) {
		border-left: none;
	}

	.doc-header :global(.store-switch-options button:hover) {
		color: var(--ink);
	}

	.doc-header :global(.store-switch-options button[aria-selected="true"]) {
		color: var(--signal);
		background: var(--paper-warm);
	}

	.doc-body :global(.diagram),
	.doc-body :global(.diagram code) {
		line-height: 1;
		font-variant-ligatures: none;
		font-feature-settings: "liga" 0, "calt" 0, "kern" 0;
		letter-spacing: 0;
		text-rendering: geometricPrecision;
		font-size: 0.7rem;
	}

	.doc-body :global(pre code) {
		background: transparent;
		padding: 0;
		color: inherit;
		border-radius: 0;
		white-space: pre;
	}

	.doc-body :global(.table-wrap) {
		overflow-x: auto;
		margin: 1.25rem 0;
	}

	.doc-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		min-width: 520px;
		margin: 0;
		border: 1px solid var(--rule);
	}

	.doc-body :global(th),
	.doc-body :global(td) {
		text-align: left;
		vertical-align: top;
		padding: 0.8rem 0.9rem;
		border-bottom: 1px solid var(--rule);
	}

	.doc-body :global(th) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		background: var(--paper-warm);
	}

	.doc-body :global(td) {
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}

	.doc-body :global(tr:last-child td) {
		border-bottom: none;
	}

	.doc-body :global(.link-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.8rem;
		margin: 1.25rem 0;
	}

	.doc-body :global(.doc-card) {
		min-height: 9rem;
		border: 1px solid var(--rule);
		background: var(--paper-warm);
		padding: 1rem;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.doc-body :global(.doc-card:hover) {
		border-color: var(--signal);
	}

	.doc-body :global(.doc-card strong) {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		color: var(--signal);
	}

	.doc-body :global(.doc-card span) {
		color: var(--ink-soft);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.doc-pagination {
