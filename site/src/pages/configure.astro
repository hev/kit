---
import Base from '../layouts/Base.astro';
---
<Base title="Configure your app · hev kit" description="Name and style your team's mobile app. Save a kit-dot.json, entirely in your browser." privateForm={true}>
<main class="configure">
  <header class="intro"><p class="eyebrow">YOUR TEAM'S MOBILE APP</p><h1>Make it your dot.</h1><p>An installable, voice-first web app for your team. Give it a name, a voice and a face.</p><p>Your settings and image stay in this browser. Nothing is uploaded.</p></header>
  <div class="workspace">
    <form id="config-form" novalidate>
      <h2>The details</h2>
      <label>Dot name<input name="name" value="kit dot" maxlength="80" /></label>
      <fieldset><legend>Wordmark</legend><div class="pair"><label>First part<input name="word0" value="kit" maxlength="80" /></label><label>Second part<input name="word1" value="dot" maxlength="80" /></label></div></fieldset>
      <label>Accent colour<div class="color-row"><input type="color" id="picker" value="#e25822" aria-label="Pick accent colour" /><input name="color" value="#e25822" aria-label="Accent hex colour" /></div></label>
      <label>Voice<select name="voice"><option>Algenib</option><option>Kore</option><option>Puck</option><option>Aoede</option></select></label><p class="hint">The Gemini Live voice your dot uses for spoken replies. This preview shows a sample transcript.</p>
      <label>Your name<input name="operator" value="Your name" maxlength="80" /></label>
      <label>Allowed logins<textarea name="logins" rows="3">you@example.com</textarea></label><p class="hint">Email addresses, one per line. At least one is required.</p>
      <label>Host names (optional)<textarea name="hosts" rows="3" placeholder="build-host"></textarea></label><p class="hint">One per line, from <code>hev dispatch hosts</code>.</p>
      <fieldset class="acts"><legend>Actions</legend><label class="switch"><input type="checkbox" name="live" /> Enable live acts</label><p class="hint">Off means dry-run. On lets confirmed actions change your runs and cluster; each still needs a spoken read-back and a yes.</p></fieldset>
      <fieldset id="drop"><legend>Your icon</legend><label>Drop or choose one square PNG<input id="icon-input" type="file" accept="image/png" /></label><p class="hint">At least 512 × 512 px. Keep artwork inside the centre 80% circle.</p><button type="button" id="reset-icon">Use stock icon</button><p id="icon-status" role="status">Using the stock kit icon.</p><p class="hint">On iOS, a changed icon usually needs the app removed and re-added.</p></fieldset>
    </form>
    <section class="preview" aria-label="Live app preview">
      <p class="eyebrow">LIVE PREVIEW</p>
      <div class="phone" id="phone"><div class="phone-top">9:41 <span>•••</span></div><h2 id="wordmark">kit <span>dot</span></h2><p id="dot-name">kit dot</p><img class="orb icon-preview" src="/favicon.png" alt="Your dot's orb" /><p class="listening">Ready when you are</p><div class="exchange"><p class="question">“What's waiting on me?”</p><p id="reply">Your name, one run needs a decision. The team is waiting for you to choose a release window.</p><small id="voice-label">Algenib · sample reply</small></div><p id="mode">Dry-run · actions need your yes</p></div>
      <div class="icon-grid"><figure class="home-screen"><img class="icon-preview home-icon" src="/favicon.png" alt="192 px home-screen icon" /><figcaption id="home-name">kit dot</figcaption></figure><figure><img id="mask-preview" class="icon-preview mask" src="/favicon.png" alt="512 px maskable icon in a round mask" /><figcaption>Round mask · 512</figcaption></figure><figure><img id="favicon-preview" src="/favicon.png" width="32" height="32" alt="32 px favicon preview" /><figcaption>Favicon · 32</figcaption></figure><figure><img id="apple-preview" class="icon-preview apple" src="/favicon.png" alt="180 px Apple touch icon" /><figcaption>Apple touch · 180</figcaption></figure></div>
      <p class="hint">Also cuts a 512 px app icon. Generated filenames include the image hash so phones can refresh cached icons.</p><ul id="cuts"></ul>
    </section>
  </div>
  <section class="output"><h2>Your kit-dot.json</h2><p>Save it beside <code>icon.png</code> if you use your own icon. <a href="/docs/mobile-app-config">Config reference</a> · <a href="/schemas/kit-dot.schema.json">JSON Schema</a></p><p id="errors" role="status"></p><pre><code id="json"></code></pre><div class="buttons"><button id="copy" type="button">Copy JSON</button><button id="download" type="button">Download kit-dot.json</button><button id="download-icon" type="button" disabled>Download icon.png</button></div><p id="copy-status" role="status"></p></section>
  <section class="next"><h2>Give your team a dot</h2><p><strong>Field Kit hosts your dot for your team.</strong> Hosting is part of <a href="/pricing#start">Field Kit sign-up</a>.</p><p><strong>Pro Kit runs in your cloud next to hev layer.</strong> <a href="/pricing">See the plans</a>.</p><p>The generic template dot is being built. This page prepares its config; it does not deploy an app.</p></section>
</main>
</Base>
<script>
import '../scripts/configure';
</script>
<style>
.configure{width:var(--page);margin:0 auto;padding:4rem 0}.intro{max-width:730px;margin-bottom:3rem}.eyebrow{font: .75rem 'JetBrains Mono Variable',monospace;letter-spacing:.12em;color:var(--signal)}h1{font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.15;margin:.7rem 0 1.3rem;letter-spacing:-.05em}h2{font-size:1.4rem;margin-bottom:1rem}p{margin-bottom:.75rem}a{color:var(--signal)}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:4rem}form,.preview{min-width:0}label{display:block;font-weight:500;margin:.8rem 0 .4rem}input,textarea,select{width:100%;padding:.7rem;background:var(--input-bg);color:var(--ink);border:1px solid var(--rule-strong);border-radius:5px;font:inherit}textarea{resize:vertical}fieldset{border:0;margin-top:1.3rem}legend{font-weight:600}.pair{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.hint,small{font-size:.85rem;color:var(--ink-soft)}.color-row{display:flex;gap:.6rem}#picker{width:4rem;height:3.2rem;padding:.2rem}.switch{display:flex;align-items:center;gap:.6rem}.switch input{width:1.2rem;height:1.2rem}#drop{border:1px dashed var(--rule-strong);padding:1rem;border-radius:8px}button{background:var(--paper-warm);border:1px solid var(--rule-strong);color:var(--ink);padding:.65rem 1rem;border-radius:5px;cursor:pointer;font:inherit}button:disabled{opacity:.45;cursor:default}input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid var(--signal);outline-offset:3px}.phone{--accent:#e25822;max-width:330px;margin:1rem auto 2rem;padding:1.3rem;border:7px solid var(--rule-strong);border-radius:42px;background:var(--paper-warm);min-height:570px;text-align:center;box-shadow:0 15px 40px #0002}.phone-top{display:flex;justify-content:space-between;font-size:.7rem;margin-bottom:2rem}.phone h2{font-size:2rem;overflow-wrap:anywhere}.phone h2 span{color:var(--accent)}#dot-name{font-size:.8rem}.orb{width:105px;height:105px;object-fit:contain;margin:1.5rem auto;border-radius:50%;box-shadow:0 0 45px color-mix(in srgb,var(--accent),transparent 65%)}.listening{color:var(--accent);font-size:.85rem}.exchange{text-align:left;margin:1.5rem 0;padding:1rem;border-left:2px solid var(--accent)}.question{font-weight:600}#mode{font-size:.75rem}.icon-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;text-align:center}.icon-grid figure{padding:1rem;border:1px solid var(--rule);border-radius:12px}.icon-grid img{object-fit:contain}.home-screen{background:linear-gradient(135deg,var(--paper-warm),var(--rule))}.home-icon,.mask,.apple{width:64px;height:64px;border-radius:14px}.mask{border-radius:50%;background:var(--paper-warm)}figcaption{font-size:.75rem;margin-top:.4rem}.output,.next{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--rule)}pre{padding:1.5rem;background:var(--code-bg);color:var(--code-ink);overflow:auto;font-size:.85rem;margin:1rem 0}.buttons{display:flex;gap:.6rem;flex-wrap:wrap}#errors,#icon-status{overflow-wrap:anywhere}#cuts{font-size:.75rem;overflow-wrap:anywhere;list-style:none}.next{max-width:730px}@media(max-width:700px){.workspace{grid-template-columns:1fr;gap:2rem}.configure{padding-top:2rem}.intro{margin-bottom:2rem}}
</style>
