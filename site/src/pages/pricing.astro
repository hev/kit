---
import Base from "../layouts/Base.astro";

// Every number on this page lives in `pricing` below. They're placeholders:
// change them here and the markup, the crossover line and the FAQ follow.
// Placeholder: hosted sign-up isn't live yet, so Field Kit's "Start" points at the
// start note on this page, not a sign-up URL.
const START_HREF = "#start";
// The site's only contact so far: the "Book a call" link on /docs/invited.
const CONTACT_HREF = "https://hevmind.com/book/";

const pricing = {
	headline: "Let's work together!",
	subhead: "Sign up and invite your team.",
	// Tier titles and the deployment line under each.
	names: {
		starter: { name: "Starter Kit", descriptor: "open source, on your machine" },
		advanced: { name: "Field Kit", descriptor: "hosted by us" },
		pro: { name: "Pro Kit", descriptor: "BYOC with", link: { text: "hev layer", href: "https://hevlayer.com" } },
	},
	cloud: {
		baseMonthly: 25, // $ / month
		includedGB: 5, // GB stored, measured monthly
		includedSearches: 1_000_000, // searches / month
		perGBMonth: 2, // $ per GB-month stored beyond the included amount
		perExtraSearchBlock: 10, // $ per block of searches beyond the included amount
		searchBlock: 1_000_000, // searches in one block
	},
	enterprise: {
		listMonthly: 1024, // $ / month per instance, billed annually
		launchPartnerDiscount: 0.5, // launch partners pay list x (1 - discount)
		launchPartnerSpotsRemaining: 3, // decrement by hand; at 0 the sale is hidden and list price shows

		includedGB: 1024, // GB of index included (1 TB)
		// Storage beyond the included amount is sold in TB blocks. The customer also
		// pays their own store for the bytes, so this stays well under a hosted rate.
		perTBBlock: 100, // $ / month per additional TB block
		// TODO(adam): Enterprise query allowance and overage are undecided. The
		// page shows no Enterprise query pricing until these are set.
		includedSearches: null,
		perExtraSearchBlock: null,
	},
};

// Art slots beyond the hero and the start note. null renders nothing.
const art: { crossover: string | null } = {
	crossover: null, // TODO(art): see the slot note beside the crossover line
};

const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
const count = (n: number) => n.toLocaleString("en-US");
const gb = (n: number) => (n >= 1024 && n % 1024 === 0 ? `${n / 1024} TB` : `${count(n)} GB`);

const { cloud, enterprise } = pricing;
const STARTER = pricing.names.starter.name;
const ADVANCED = pricing.names.advanced.name;
const PRO = pricing.names.pro.name;
const partnerMonthly = Math.round(enterprise.listMonthly * (1 - enterprise.launchPartnerDiscount));
const discountPercent = Math.round(enterprise.launchPartnerDiscount * 100);
const spots = enterprise.launchPartnerSpotsRemaining;
const saleOn = spots > 0 && enterprise.launchPartnerDiscount > 0;

// Where a Cloud bill reaches Enterprise's list price, holding the other
// dimension at its included amount. Computed, so it moves with the prices.
const headroom = enterprise.listMonthly - cloud.baseMonthly;
const crossoverGB = Math.round(cloud.includedGB + headroom / cloud.perGBMonth);
const crossoverSearchesM = Math.round(
	(cloud.includedSearches + (headroom / cloud.perExtraSearchBlock) * cloud.searchBlock) / 1_000_000,
);

// Nodes: machines running kit's daemon. Starter is three nodes (not enforced in
// code today; the page states the plan, not the enforcement).
const nodes: Record<string, number | null> = { starter: 3, advanced: null, pro: null };
const nodesLabel = (n: number | null) => (n === null ? "Unlimited nodes" : `${n} ${n === 1 ? "node" : "nodes"}`);

const tiers = [
	{
		id: "open-source",
		name: STARTER,
		where: pricing.names.starter.descriptor,
		price: "Free",
		unit: "Apache-2.0",
		included: [
			"Everything, on local disk",
			"Traces and trace search, the board, peers and the dashboard",
		],
		nodes: nodesLabel(nodes.starter),
		people: "Unlimited agents on those nodes",
		cta: { label: "Install", href: "/docs/install" },
	},
	{
		id: "cloud",
		name: ADVANCED,
		where: pricing.names.advanced.descriptor,
		price: usd(cloud.baseMonthly),
		unit: "base / month",
		included: [
			`${gb(cloud.includedGB)} stored`,
			`${count(cloud.includedSearches)} searches / month`,
		],
		beyond: [
			`${usd(cloud.perGBMonth)} per GB-month stored`,
			`${usd(cloud.perExtraSearchBlock)} per additional ${count(cloud.searchBlock)} searches`,
			"No ceiling",
		],
		nodes: nodesLabel(nodes.advanced),
		people: "Unlimited people and agents",
		how: "Open sign-up: a card to start, or an invite code for free credit.",
		cta: { label: "Start", href: START_HREF },
		featured: true,
	},
	{
		id: "enterprise",
		name: PRO,
		where: pricing.names.pro.descriptor,
		price: usd(enterprise.listMonthly),
		from: true,
		unit: "per instance / month, billed annually",
		partner: saleOn
			? {
					price: usd(partnerMonthly),
					label: `${discountPercent}% off for launch partners`,
					spots: `${spots} ${spots === 1 ? "spot" : "spots"} remaining`,
					note: "Launch partners keep this price for as long as their license continues.",
				}
			: null,
		included: [`${gb(enterprise.includedGB)} of index`, "Your store, your data", "kit included", "SLA and migration help"],
		whereLink: pricing.names.pro.link,
		beyond: [`${usd(enterprise.perTBBlock)} / month per additional TB`],
		nodes: nodesLabel(nodes.pro),
		people: "Unlimited people and agents",
		how: "Talk to us.",
		cta: { label: saleOn ? "Become a launch partner" : "Talk to us", href: CONTACT_HREF },
	},
];

const faq = [
	{
		q: "Do people or agents cost anything?",
		a: `No. Agents are unlimited on every plan, and ${ADVANCED} and ${PRO} have unlimited people. Invite everyone and run every agent the work needs; the bill follows what you store and search, not who or what is doing it.`,
	},
	{
		q: "What is a node?",
		a: `A machine running kit: your laptop, a build box, a cloud VM your agents work on. ${STARTER} runs on up to ${nodes.starter} nodes, so you can send work from your laptop to a machine in the back and let agents run there. Each ${STARTER} node keeps its own traces and board in local files. ${ADVANCED} and ${PRO} connect as many nodes as you have and give them one shared set of traces, one board and one set of peers.`,
	},
	{
		q: "What counts as a search?",
		a: "Only searches: a query against your traces or the board. Opening a session, listing the board and browsing the dashboard don't count.",
	},
	{
		q: "What does storage mean?",
		a: "The data you keep, measured monthly, in GB-months. Writing traces is free; you pay for what stays stored.",
	},
	{
		q: "How long are traces kept?",
		a: `In ${STARTER}, on your disk for as long as you like. In ${ADVANCED}, until you delete them; a team can also set a retention period of 30, 90 or 365 days, or keep them forever. Retention decides what stays stored, so it's how you control the storage bill.`,
	},
	{
		q: `When does ${PRO} make more sense than ${ADVANCED}?`,
		a: `${ADVANCED} has no ceiling. At about ${gb(crossoverGB)} stored, or about ${count(crossoverSearchesM)} million searches a month, your ${ADVANCED} bill reaches ${PRO}'s ${usd(enterprise.listMonthly)} list price. Near there, owning it in your own cloud is the better deal.`,
	},
	{
		q: "What does an invite code give me?",
		a: `Free ${ADVANCED} credit. Codes go out at talks and in posts, and the amount of credit is set per code.`,
	},
	...(saleOn
		? [
				{
					q: "What is the launch-partner price?",
					a: `${PRO} at ${discountPercent}% off list, ${usd(partnerMonthly)} instead of ${usd(enterprise.listMonthly)} a month per instance, for a limited number of launch partners (${spots} ${spots === 1 ? "spot" : "spots"} remaining). Launch partners keep that price for as long as their license continues. Talk to us to become one.`,
				},
			]
		: []),
	{
		q: `What stays local in ${STARTER}?`,
		a: "Everything. Traces and their search index, the board, the dashboard, run records and peers are plain files on each machine kit runs on. There is no account, no key and no Docker. It is not a trial: it is complete for one person and a few machines.",
	},
	{
		q: `What happens to my local history when I move to ${ADVANCED}?`,
		a: `Bringing your local traces and board into ${ADVANCED} is planned, not shipped. Today, moving to ${ADVANCED} starts an empty shared archive and leaves your local files where they are, still readable.`,
	},
	{
		q: `Where does ${PRO} data live?`,
		a: "In your cloud. You run the hev layer yourself, against your own store, and kit talks to it. Your traces and board never pass through our hosted service. Your store bills you directly for what it holds, which is why storage beyond the included TB is priced per TB block and kept low.",
	},
];
---

<Base
	title="hev kit pricing: free seats, pay for what you store and search"
	description="Starter Kit is free and open source on up to three machines. Field Kit, hosted by us, charges for data stored and searches run, with unlimited people and agents. Pro Kit runs in your own cloud."
	current="pricing"
>
	<main>
		<section class="pricing-head">
			<div class="head-copy">
				<p class="kicker">// pricing</p>
				<h1>{pricing.headline}</h1>
				<p class="subhead">{pricing.subhead}</p>
				<p class="lede">
					{STARTER} is free on your own machines, with everything in local files.
					{ADVANCED} shares your traces, the board and peers across your team, so every
					person and every machine works from the same record. Bring everyone:
					seats cost nothing.
				</p>
				<p class="per-person"># Seats and agents are free on every plan. You pay for storage and searches.</p>
			</div>
			<img
				class="head-art"
				src="/img/disco.png"
				alt="The pixel-art mascot dancing with a long trace scrolling out behind him."
				width="222"
				height="300"
			/>
		</section>

		<section class="plans" aria-label="Plans">
			<div class="tiers">
				{
					tiers.map((t) => (
						<article class:list={["tier", { featured: t.featured }]} id={t.id}>
							<p class="tier-label">// {t.name}</p>
							<p class="tier-where">
								{t.where}
								{t.whereLink && (
									<>
										{" "}
										<a href={t.whereLink.href}>{t.whereLink.text}</a>
									</>
								)}
							</p>
							<p class="tier-price">
								{t.partner ? (
									<>
										<span class="amount">
											{t.from && <span class="from">From </span>}
											<s class="list-price">{t.price}</s> {t.partner.price}
										</span>
										<span class="unit">{t.unit}</span>
										<span class="partner-label">
											{t.partner.label} · {t.partner.spots}
										</span>
									</>
								) : (
									<>
										<span class="amount">
											{t.from && <span class="from">From </span>}
											{t.price}
										</span>
										<span class="unit">{t.unit}</span>
									</>
								)}
							</p>
							{t.partner && <p class="partner-note">{t.partner.note}</p>}
							<div class="tier-block">
								<p class="tier-block-label">Included</p>
								<ul class="tier-features">
									{t.included.map((f) => (
										<li>{f}</li>
									))}
								</ul>
							</div>
							{t.beyond && (
								<div class="tier-block">
									<p class="tier-block-label">Beyond that</p>
									<ul class="tier-features">
										{t.beyond.map((f) => (
											<li>{f}</li>
										))}
									</ul>
								</div>
							)}
							<div class="tier-block">
								<p class="tier-block-label">Nodes</p>
								<ul class="tier-features">
									<li>{t.nodes}</li>
								</ul>
							</div>
							<div class="tier-block">
								<p class="tier-block-label">People and agents</p>
								<ul class="tier-features">
									<li>{t.people}</li>
								</ul>
							</div>
							{t.how && <p class="tier-how">{t.how}</p>}
							<a href={t.cta.href} class:list={["btn", { primary: t.featured }]}>
								{t.cta.label}
							</a>
						</article>
					))
				}
			</div>
			{/* TODO(art): an optional piece beside the crossover line, about 220 x 160,
			    mood: "owning it", the archive in your own cloud. Set art.crossover
			    and it shows; until then nothing renders. */}
			{art.crossover && <img class="crossover-art" src={art.crossover} alt="" width="220" height="160" />}
			<p class="crossover">
				<strong>{ADVANCED} has no ceiling.</strong> At about {gb(crossoverGB)} stored,
				or about {count(crossoverSearchesM)} million searches a month, your {ADVANCED}
				bill reaches {PRO}'s {usd(enterprise.listMonthly)} list price. When your
				{ADVANCED} bill gets near that, owning it with {PRO} is the better deal.
			</p>
		</section>

		<section id="start" class="note-section with-art">
			<div class="section-heading">
				<p class="section-label"># starting on {ADVANCED}</p>
				<h2>Start with a card or an invite code.</h2>
				<p>
					{ADVANCED} sign-up will be open to anyone: put a card on file to start,
					or use an invite code for free credit. Codes go out at talks and in
					posts, and each one sets its own amount of credit. With a code,
					<code>hev join CODE</code> connects your machine.
				</p>
				<p>
					Hosted sign-up isn't live yet. Until it is, {STARTER} is free and
					complete on up to three machines.
				</p>
				<p><a href="/docs/install" class="text-link">Install kit</a></p>
			</div>
			<img
				class="side-art"
				src="/img/hevd.png"
				alt="hevd, a small red imp in a diving mask and flippers"
				width="195"
				height="200"
				loading="lazy"
			/>
		</section>

		<section id="faq" class="note-section">
			<div class="section-heading">
				<p class="section-label"># faq</p>
				<h2>Questions.</h2>
			</div>
			<dl class="faq">
				{
					faq.map((item) => (
						<div class="faq-row">
							<dt>{item.q}</dt>
							<dd>{item.a}</dd>
						</div>
					))
				}
			</dl>
			<p class="faq-more">
				<a href="/docs/upgrade" class="text-link">Upgrade: what each tier keeps where</a>
			</p>
		</section>
	</main>
</Base>

<style>
	main {
		width: var(--page);
		margin: 0 auto;
		padding: 0 0 5rem;
	}

	.kicker,
	.section-label,
	.tier-label,
	.per-person,
	.btn,
	.text-link,
	h1,
	h2,
	.tier-price,
	.faq dt {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.pricing-head {
		padding: 2.75rem 0 2.5rem;
		display: grid;
		grid-template-columns: minmax(0, 820px) auto;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.head-art,
	.side-art {
		image-rendering: pixelated;
		height: auto;
	}

	.head-art {
		width: 200px;
		margin-right: 2rem;
	}

	.subhead {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
		font-size: 1.25rem;
		color: var(--ink);
		margin-bottom: 1.25rem;
	}

	.note-section.with-art {
		display: grid;
		grid-template-columns: minmax(0, 760px) auto;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.side-art {
		width: 160px;
		margin-right: 2rem;
	}

	.crossover-art {
		float: right;
		width: 220px;
		height: auto;
	}

	.kicker,
	.section-label,
	.tier-label {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 1.25rem;
	}

	.kicker,
	.tier-label {
		color: var(--signal);
	}

	h1 {
		font-size: 3rem;
		line-height: 1.08;
		letter-spacing: 0;
		margin-bottom: 1rem;
	}

	h2 {
		font-size: 2rem;
		line-height: 1.15;
		letter-spacing: 0;
		margin-bottom: 1rem;
	}

	.lede,
	.section-heading p {
		color: var(--ink-soft);
		font-size: 1.0625rem;
		line-height: 1.6;
		max-width: 720px;
	}

	.section-heading p + p {
		margin-top: 1rem;
	}

	.tier-block {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.tier-block-label {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.tier-block + .tier-block {
		padding-top: 0.25rem;
	}

	.tier-features li {
		overflow-wrap: anywhere;
	}

	.crossover {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--rule-strong);
		color: var(--ink-soft);
		font-size: 0.97rem;
		line-height: 1.6;
		max-width: 820px;
	}

	.crossover strong {
		color: var(--ink);
	}

	.per-person {
		margin-top: 1.25rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}

	.per-person::first-letter {
		color: var(--signal);
	}

	.plans {
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--rule);
	}

	.tiers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.tier {
		border: 1px solid var(--rule);
		background: var(--paper-warm);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
		scroll-margin-top: var(--bar);
	}

	.tier.featured {
		border-color: var(--signal);
	}

	.tier-label {
		margin-bottom: 0;
	}

	.tier-where {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.tier-price {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.5rem 0 0.75rem;
		border-bottom: 1px dashed var(--rule-strong);
	}

	.tier-price .amount {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.15;
		color: var(--ink);
	}

	.tier-price .from {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--muted);
	}

	.tier-price .list-price {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--muted);
	}

	.tier-price .partner-label {
		margin-top: 0.35rem;
		font-size: 0.78rem;
		color: var(--signal);
	}

	.partner-note {
		color: var(--ink-soft);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.tier-price .unit {
		font-size: 0.78rem;
		color: var(--muted);
	}

	.tier-features {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.tier-features li {
		position: relative;
		padding-left: 1.1rem;
	}

	.tier-features li::before {
		content: "#";
		position: absolute;
		left: 0;
		color: var(--signal);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
	}

	.tier-how {
		color: var(--muted);
		font-size: 0.875rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		color: var(--ink);
		text-decoration: none;
		padding: 0.72rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		text-align: center;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	/* A tier without a "how" line keeps its button level with the others. */
	.tier-block + .btn {
		margin-top: auto;
	}

	.btn::before {
		content: "$";
		color: var(--signal);
	}

	.btn.primary {
		background: var(--ink);
		color: var(--paper);
		border-color: var(--ink);
	}

	.btn.primary:hover,
	.btn:hover {
		border-color: var(--signal);
		color: var(--signal);
		background: transparent;
	}

	.text-link {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.875rem;
	}

	.text-link::before {
		content: "-> ";
		color: var(--signal);
	}

	.text-link:hover {
		color: var(--signal);
	}

	.note-section {
		padding: 3rem 0;
		border-bottom: 1px solid var(--rule);
		scroll-margin-top: var(--bar);
	}

	.section-heading {
		max-width: 760px;
	}

	#faq .section-heading {
		margin-bottom: 2rem;
	}

	.faq {
		border: 1px solid var(--rule-strong);
		background: var(--paper-warm);
		max-width: 900px;
	}

	.faq-row {
		display: grid;
		grid-template-columns: minmax(200px, 0.4fr) minmax(0, 1fr);
		gap: 1.75rem;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--rule);
		align-items: baseline;
	}

	.faq-row:last-child {
		border-bottom: 0;
	}

	.faq dt {
		font-weight: 600;
		color: var(--ink);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.faq dd {
		color: var(--ink-soft);
		font-size: 0.97rem;
		line-height: 1.6;
	}

	.faq-more {
		margin-top: 1.5rem;
	}

	@media (max-width: 900px) {
		.tiers {
			grid-template-columns: 1fr;
