---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getAllDocs } from "../../lib/docs";
const entry = (await getAllDocs()).find((doc) => doc.id === "index");
if (!entry) throw new Error("Missing docs index page");
const { Content, headings } = await render(entry);
---
<DocsLayout entry={entry} headings={headings}><Content /></DocsLayout>
