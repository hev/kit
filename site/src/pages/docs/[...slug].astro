---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getAllDocs, type DocEntry } from "../../lib/docs";

export async function getStaticPaths() {
	return (await getAllDocs())
		.filter((entry) => entry.id !== "index")
		.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
---
<DocsLayout entry={entry} headings={headings}><Content /></DocsLayout>
