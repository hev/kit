---
import Base from "../layouts/Base.astro";
import HevdBanner from "../components/HevdBanner.astro";
import TraceStory from "../components/TraceStory.astro";
import Dive from "../components/deep/Dive.astro";
import Seafloor from "../components/deep/Seafloor.astro";

// The first dispatch, split where `hev up` prints hevd.
const sessionUp = `$ brew install hev
$ hev up`;
const session = `$ hev dispatch orders/fix-login-redirect.md
started fix-login-redirect

$ hev dispatch ls
NAME                 HOST      STATE    VALIDATION  AGE  PR   TRACE
fix-login-redirect   buildbox  running              4m        01a198b1-e996-78d2`;

const order = `---
name: fix-login-redirect
host: buildbox
repo: api
base: main
harness: codex
reply: laptop/front-desk
---

# Login sends people back to /home instead of where they were

After sign-in, return to the page in ?next=. Only same-site paths.

## Acceptance

- Signing in from /billing lands on /billing.
- ?next=https://evil.example is ignored and lands on /home.
- go test ./auth/... passes.`;

const pillars = [
	{
		label: "dispatch",
		title: "Send work to any host.",
		body: "An order goes out over ssh to the machine you name. A worker runs it, and the daemon on that machine collects the trace.",
		href: "/docs/dispatch",
	},
	{
		label: "admission",
		title: "The host decides what it runs.",
		body: "Each machine keeps its own list of the repos it accepts. An order for anything else is refused before a worker starts, whoever sent it.",
		href: "/docs/admission",
	},
	{
		label: "the floor",
		title: "Agents that can talk to each other.",
		body: "Peers lets live sessions on any machine message each other (built into kit in 0.6). The board is shared memory they can search.",
		href: "/docs/peers",
	},
];
---

<Base title="hev kit: make your machine part of a software factory" current="product" deep>
	<Dive />
	{/* Underwater the hero is the plunge: full bleed, at the surface, the art
	    leaving its left side to open water for the copy. The art is lazy, so
	    the plain page never fetches it. */}
	<div class="plunge">
		<picture class="plunge-art">
			<source srcset="/deep/hero-sm.webp" media="(max-width: 920px)" />
			<img
				src="/deep/hero.webp"
				width="2200"
				height="1228"
				loading="lazy"
				alt="The pixel-art mascot in a brass diving helmet swimming down through drifting transcript pages, holding a lantern."
			/>
		</picture>
		<section class="hero">
			<div class="hero-copy">
				<p class="kicker">// hev kit</p>
				<h1>Make your machine part of a software factory.</h1>
				<p class="tagline">
					One binary with the tools a factory needs: a daemon that collects traces,
					dispatch that sends work to your hosts, and an admission controller for
					repos.
				</p>
				<p class="lede">
					<code>brew install hev</code> gets you everything you need to run a
					factory. To get the most out of it you'll want headless machines,
					locally or in the cloud.
				</p>
				<p class="lede"><a href="/docs/install" class="text-link">0.6 is in progress: until it's tagged, build from source</a></p>
			</div>

			<aside class="hero-panel" aria-label="A first dispatch">
				<img class="perch" src="/deep/puffer.svg" alt="" width="70" height="43" loading="lazy" />
				<div class="panel-tab">
					<span>terminal</span>
					<span>laptop</span>
				</div>
				<pre class="map-wide"><code>{sessionUp}<HevdBanner />{session}</code></pre>
				<pre class="map-narrow"><code>{sessionUp}<HevdBanner narrow />{session}</code></pre>
			</aside>

			<div class="cta-row">
				<a href="/docs/install" class="btn primary">Install</a>
				<a href="/docs/quickstart" class="btn">Quickstart</a>
				<a href="/docs" class="text-link">Read the docs</a>
			</div>
		</section>
	</div>

	<main>

		<section id="kit" class="oss-section">
			<div class="section-heading">
				<p class="section-label"># what's in the kit</p>
				<h2>One binary per machine. No central scheduler.</h2>
				<p>
					Each host runs the same Go binary and keeps its state in plain files.
					Your laptop sends an order, the host checks it, runs a worker and
					reports back.
				</p>
			</div>
			<div class="oss-grid">
				{
					pillars.map((p) => (
						<article class="concern-card">
							<p class="surface-label">// {p.label}</p>
							<h3>{p.title}</h3>
							<p>{p.body}</p>
							<p><a href={p.href} class="text-link">More</a></p>
						</article>
					))
				}
			</div>
		</section>

		<section id="order" class="run-section" data-depth="200">
			<div class="section-heading">
				<p class="zone">twilight zone &middot; 200 m</p>
				<p class="section-label"># an order</p>
				<h2>Work goes out as a file.</h2>
				<p>
					An order is a Markdown file: where it runs, which repo, which agent, and
					what done looks like. <code>hev dispatch</code> sends it. You can
					message the worker while it runs, or send it back for rework when it
					ends.
				</p>
			</div>
			<pre class="run-output"><code>{order}</code></pre>
			<div class="run-copy">
				<p>
					<a href="/docs/orders" class="text-link">Writing orders</a>
					<a href="/docs/dispatch" class="text-link">Following a run</a>
				</p>
			</div>
		</section>

		<section id="headless" class="run-section">
			<div class="section-heading">
				<p class="section-label"># headless machines</p>
				<h2>Your laptop takes the orders. Other machines do the work.</h2>
				<p>
					A box in the closet or a VM in the cloud keeps working while your laptop
					sleeps, and runs several agents at once. Add it to your hosts, give it
					its own admission list, and dispatch to it by name.
				</p>
				<p><a href="/docs/headless" class="text-link">Add a headless machine</a></p>
			</div>
		</section>

		<section id="traces" class="run-section" data-depth="1000">
			<TraceStory>
				<div class="section-heading">
					<p class="zone">midnight zone &middot; 1,000 m</p>
					<p class="section-label"># traces</p>
					<h2>Every run is a trace.</h2>
					<p>
						hevd indexes sessions from Claude Code, Codex and other agents. Search
						them, read them back turn by turn, and see where the time and money
						went. Local by default.
					</p>
					<p><a href="/docs/traces" class="text-link">Searching traces</a></p>
				</div>
			</TraceStory>
		</section>
	</main>
	<Seafloor />
</Base>

<style>
	main {
		width: var(--page);
		margin: 0 auto;
		padding: 0 0 5rem;
	}

	/* The buttons sit under the map, not under the copy. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.78fr) minmax(560px, 1fr);
		grid-template-rows: auto 1fr;
		grid-template-areas:
			"copy panel"
			"copy cta";
		column-gap: 3rem;
		row-gap: 1.5rem;
		align-items: start;
		width: var(--page);
		margin: 0 auto;
		padding: 2.75rem 0 4rem;
		border-bottom: 1px solid var(--rule);
	}

	.kicker,
	.section-label,
	.surface-label,
	.partner-card-label,
	.panel-tab,
	.btn,
	.text-link,
	.signup-form label,
	.signup-form button,
	.signup-note,
	.signup-fineprint,
	.gate-note {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.kicker,
	.section-label,
	.surface-label,
	.partner-card-label {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 1.25rem;
	}

	.kicker {
		color: var(--signal);
	}

	.section-label .status-tag,
	.surface-label .status-tag {
		color: var(--signal);
		margin-left: 0.35rem;
	}

	.surface-label,
	.partner-card-label {
		color: var(--signal);
		margin-bottom: 0.75rem;
	}

	h1,
	h2,
	h3 {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		letter-spacing: 0;
	}

	h1 {
		font-size: 3.25rem;
		line-height: 1.08;
		margin-bottom: 1rem;
	}

	h2 {
		font-size: 2rem;
		line-height: 1.15;
		margin-bottom: 1rem;
	}

	h3 {
		font-size: 1.15rem;
		line-height: 1.3;
	}

	.tagline {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1.25rem;
		line-height: 1.35;
		color: var(--signal);
		margin-bottom: 1.25rem;
		max-width: 26em;
	}

	.oss-section {
		padding: 3rem 0 4.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.oss-section .section-heading .text-link + .text-link {
		margin-left: 1.25rem;
	}

	.oss-start {
		margin: 1.5rem 0;
	}

	.oss-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 920px) {
		.oss-grid {
			grid-template-columns: 1fr;
		}

		.hero-panel {
			margin-top: 0;
		}
	}

	.lede,
	.section-heading p,
	.partner-cta p {
		color: var(--ink-soft);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.lede {
		max-width: 620px;
		margin-bottom: 2rem;
	}

	.hero-copy { grid-area: copy; }
	.hero-panel { grid-area: panel; }

	.cta-row {
		grid-area: cta;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		color: var(--ink);
		text-decoration: none;
		padding: 0.72rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	.btn::before {
		content: "$";
		color: var(--signal);
	}

	.btn.primary {
		background: var(--ink);
		color: var(--paper);
		border-color: var(--ink);
	}

	.btn.primary:hover,
	.btn:hover {
		border-color: var(--signal);
		color: var(--signal);
		background: transparent;
	}

	.text-link {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.875rem;
	}

	.text-link::before {
		content: "-> ";
		color: var(--signal);
	}

	.text-link:hover {
		color: var(--signal);
	}

	.signup-form {
		border: 1px solid var(--rule);
		background: var(--paper-warm);
		padding: 1rem;
		max-width: 540px;
	}

	.signup-form label {
		display: block;
		color: var(--ink);
		font-size: 0.8125rem;
		line-height: 1.45;
		margin-bottom: 0.75rem;
	}

	.signup-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.75rem;
		align-items: stretch;
	}

	.signup-row input {
		width: 100%;
		min-width: 0;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink);
		padding: 0.75rem 0.85rem;
		font: inherit;
		border-radius: 0;
	}

	.signup-row input:focus {
		outline: 2px solid var(--signal);
		outline-offset: 2px;
	}

	.signup-row button {
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--paper);
		padding: 0 1rem;
		font-size: 0.8125rem;
		white-space: nowrap;
		cursor: pointer;
	}

	.signup-row button:hover {
		background: var(--signal);
		border-color: var(--signal);
	}

	.signup-note,
	.signup-fineprint,
	.gate-note {
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
		margin-top: 0.75rem;
	}

	.signup-note:empty {
		display: none;
	}

	.gate-note {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--rule);
	}

	.gate-note a {
		color: var(--ink-soft);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.gate-note a:hover {
		color: var(--signal);
	}

	.hero-panel {
		/* Line the map up with the headline rather than the kicker. */
		margin-top: 2.5rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper-warm);
		min-width: 0;
		container-type: inline-size;
	}

	.panel-tab {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.75rem;
		padding: 0.75rem 1rem;
	}

	pre {
		overflow-x: auto;
		padding: 1.5rem;
		color: var(--ink-soft);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.875rem;
		line-height: 1.65;
	}

	.hero-panel pre {
		padding: 1rem;
	}

	/* The 90-column map needs ~576px of panel; below that it clips, so the
	   phone-shaped 34-column cut takes over. */
	.map-narrow {
		display: none;
	}

	@media (max-width: 620px) {
		.map-wide {
			display: none;
		}

		.map-narrow {
			display: block;
		}
	}

	.hero-panel pre,
	.hero-panel pre code {
		font-size: 0.66rem;
		line-height: 1.05;
		font-variant-ligatures: none;
		font-feature-settings: "liga" 0, "calt" 0, "kern" 0;
		letter-spacing: 0;
		text-rendering: geometricPrecision;
	}

	.hero-panel .map-narrow,
	.hero-panel .map-narrow code {
		/* 34 columns of JetBrains Mono is 20.4em wide. Size it off the panel so
		   the map fills a 390px phone and still fits a 320px one; the flat 0.8rem
		   is the fallback where container units aren't understood. */
		font-size: 0.8rem;
		font-size: min(0.95rem, 4.2cqi);
		line-height: 1.2;
	}

	pre code {
		background: transparent;
		color: inherit;
		padding: 0;
	}

	.concerns,
	.run-section,
	.box-section,
	.open-core,
	.why-now,
	.vendors,
	.partner-cta {
		padding: 3rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.section-heading {
		max-width: 760px;
		margin-bottom: 2.5rem;
	}

	.vendors {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.vendors .section-heading {
		margin-bottom: 0;
	}

	.vendor-logo {
		flex: 0 0 auto;
		margin-right: 6rem;
	}

	@media (max-width: 1100px) {
		.vendor-logo {
			margin-right: 0;
		}
	}

	.vendor-logo img {
		display: block;
		max-width: 100%;
		height: auto;
		opacity: 0.9;
		transition: opacity 0.15s ease;
	}

	.vendor-logo:hover img {
		opacity: 1;
	}

	.tier-list {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border: 1px solid var(--rule-strong);
		background: var(--paper-warm);
	}

	.tier-row {
		padding: 1.25rem 1.4rem;
		border-right: 1px solid var(--rule);
	}

	.tier-row:last-child {
		border-right: 0;
	}

	.tier-row dt {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-weight: 600;
		color: var(--ink);
		font-size: 0.95rem;
		margin-bottom: 0.7rem;
	}

	.tier-row dd {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.concern-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.concern-card {
		border: 1px solid var(--rule);
		background: var(--paper-warm);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	/* Footer row: link on the left, drawing tucked into the lower right. Sharing
	   a line with the link keeps the icon off its own row, so the card is shorter
	   than when it sat on top. margin-top:auto pins it to the bottom so a row of
	   cards with uneven copy still lines its icons up. */
	.concern-foot {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	/* Same ink-and-wash hand as the drawings on /about, keyed to transparent so
	   the card ground shows through. */
	.concern-icon {
		display: block;
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex: none;
	}

	.concern-card h3 {
		margin-bottom: 0.35rem;
	}

	.concern-card p:last-of-type {
		color: var(--ink-soft);
		line-height: 1.6;
		font-size: 0.97rem;
	}

	.concern-card .card-link {
		margin-top: auto;
		padding-top: 0.75rem;
	}

	.run-output {
		background: var(--code-bg);
		color: var(--code-ink);
		padding: 1.5rem 1.75rem;
		margin: 0 0 2rem;
		border: 1px solid var(--rule-strong);
		font-size: 0.95rem;
		line-height: 1.5;
		white-space: pre;
		overflow-x: auto;
	}

	.run-output code {
		background: transparent;
		color: inherit;
		padding: 0;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.run-copy {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: 760px;
	}

	.run-copy p {
		color: var(--ink-soft);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.run-copy code {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.9em;
		padding: 0.05em 0.3em;
		background: var(--paper-warm);
		border: 1px solid var(--rule);
	}

	.box-list {
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border: 1px solid var(--rule-strong);
		background: var(--paper-warm);
	}

	.box-row {
		display: grid;
		grid-template-columns: minmax(160px, 0.25fr) minmax(0, 1fr);
		gap: 1.75rem;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--rule);
		align-items: baseline;
	}

	.box-row:last-child {
		border-bottom: 0;
	}

	.box-row dt {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-weight: 600;
		color: var(--ink);
		font-size: 0.95rem;
	}

	.box-row dd {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.97rem;
		line-height: 1.55;
	}

	.box-footnote {
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.55;
		margin-top: 1.5rem;
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.why-sub {
		color: var(--signal);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1rem;
		margin-top: 0.5rem;
	}

	.why-body {
		max-width: 720px;
		color: var(--ink-soft);
		font-size: 1.0625rem;
		line-height: 1.65;
		margin-bottom: 2rem;
	}

	.why-punch {
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1.75rem;
		color: var(--ink);
		font-weight: 600;
	}

	.partner-cta {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 4rem;
		align-items: start;
	}

	.partner-cta p {
		margin-bottom: 1.25rem;
	}

	.partner-card {
		border: 1px solid var(--rule);
		background: var(--paper-warm);
		padding: 1.5rem;
	}

	.partner-criteria {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.partner-criteria li {
		position: relative;
		padding-left: 1.25rem;
		color: var(--ink-soft);
		line-height: 1.5;
	}

	.partner-criteria li::before {
		content: "#";
		position: absolute;
		left: 0;
		color: var(--signal);
		font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	@media (max-width: 920px) {
		.hero,
		.concern-grid,
		.tier-list,
		.partner-cta {
