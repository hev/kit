{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hevkit.com/schemas/kit-dot.schema.json",
  "title": "Kit dot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "wordmark",
    "operator",
    "color",
    "voice",
    "logins",
    "hosts",
    "icon",
    "acts"
  ],
  "properties": {
    "version": {
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S",
      "default": "kit dot"
    },
    "wordmark": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S"
      },
      "minItems": 2,
      "maxItems": 2,
      "default": [
        "kit",
        "dot"
      ]
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S",
      "default": "Your name"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#e25822"
    },
    "voice": {
      "type": "string",
      "enum": [
        "Algenib",
        "Kore",
        "Puck",
        "Aoede"
      ],
      "default": "Algenib"
    },
    "logins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 254,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "default": [
        "you@example.com"
      ]
    },
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "default": []
    },
    "icon": {
      "default": null,
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "sha256"
          ],
          "properties": {
            "file": {
              "const": "icon.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "acts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live"
      ],
      "properties": {
        "live": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {
        "live": false
      }
    }
  }
}
